create table branch(branch_name varchar(100)primary key,branch_city varchar(100)not null, assert real);
create table bankacc(accno int primary key,
                    branch_name varchar(100),
                    foreign key(branch_name)references branch(branch_name),balance real);
create table bankcust(cust_name varchar(100)primary key,cust_street varchar(100)not null,cust_city varchar(100));
create table depositer(cust_name varchar(100),foreign key(cust_name)references bankcust(cust_name),accno int);
create table loan(loan_no int primary key,branch_name varchar(100),foreign key(branch_name)references branch(branch_name),amount real);

